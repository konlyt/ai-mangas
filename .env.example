# ============================================================
# AI漫剧制作平台 环境变量示例
# 复制本文件为 .env 并填入实际值；.env 不会被提交到仓库
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=AnimeWorld

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT 认证 ----------
JWT_SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- AES 加密（用于 API Key 加密存储，32字节 hex）----------
AES_SECRET_KEY=0123456789abcdef0123456789abcdef

# ---------- DeepSeek LLM（LiteLLM 调用）----------
DEEPSEEK_API_KEY=sk-0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------- Agnes AI（文本/图像/视频/TTS 统一网关，OpenAI 兼容）----------
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_LLM_API_KEY=
AGNES_LLM_MODEL=agnes-3.0-flash
AGNES_IMAGE_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_API_KEY=
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# ---------- 服务端口 ----------
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=5173

# ---------- 运行模式 ----------
ENV=development
LOG_LEVEL=INFO
